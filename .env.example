# Private Key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# WETH Contract Address
# Scroll Sepolia WETH: 0x5300000000000000000000000000000000000004
WETH_ADDRESS=0x5300000000000000000000000000000000000004

# Scroll Sepolia Testnet Configuration
# Network Name: Scroll Sepolia Testnet
# Chain ID: 534351
# Currency Symbol: ETH
SCROLL_SEPOLIA_RPC_URL=https://sepolia-rpc.scroll.io
SCROLL_SEPOLIA_CHAIN_ID=534351
SCROLL_SEPOLIA_EXPLORER=https://sepolia.scrollscan.com

# Etherscan API Key for contract verification (optional)
# For Scroll Sepolia, you may need a Scrollscan API key
ETHERSCAN_API_KEY=your_etherscan_api_key_here
